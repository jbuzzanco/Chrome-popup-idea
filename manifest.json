{
  "manifest_version": 3,
  "name": "Keyword Detector",
  "version": "1.0",
  "description": "Detects keywords like 'red' or 'blue' on webpages and shows a popup notification",
  "permissions": ["activeTab", "storage", "scripting"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["keywordMatcher.js", "notification.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Keyword Detector"
  }
}
